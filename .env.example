# =============================================================================
# Rauell OS - Environment Configuration
# Copy to .env and fill in values. NEVER commit the real .env file.
# =============================================================================

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Works with Neon (https://neon.tech) or any
# Postgres 14+. Neon console -> Project -> Dashboard -> Connection string.
# Add "?sslmode=require" for Neon.
DATABASE_URL="postgresql://user:password@localhost:5433/rauell_os"

# Public base URL of the deployment (used for OAuth redirects and links)
APP_URL="http://localhost:3000"

# Node environment (set automatically by platforms)
# NODE_ENV="development"

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# 32-byte key (base64 or hex) used to encrypt OAuth tokens at rest with
# AES-256-GCM. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Secret required by the /api/cron endpoint (scheduler tick).
# Generate: openssl rand -hex 24
CRON_SECRET=""

# Optional: when set, /setup can only be used with this token.
# Recommended for public deployments. Leave empty for local installs.
SETUP_TOKEN=""

# ---------------------------------------------------------------------------
# AI providers (optional - the app is fully usable without AI)
# ---------------------------------------------------------------------------
# Provider: openai | anthropic | google
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL=""
# Model roles (fallbacks to sensible defaults per provider when empty)
AI_MODEL_FAST=""
AI_MODEL_RESEARCH=""
AI_MODEL_REASONING=""
AI_MODEL_WRITING=""
AI_MODEL_DOC_EXTRACT=""
# Embedding model (enables semantic search / RAG when set)
AI_EMBEDDING_MODEL=""
# Cost + behaviour guards
AI_MONTHLY_BUDGET_USD="10"
AI_MAX_OUTPUT_TOKENS="2000"

# ---------------------------------------------------------------------------
# Integrations (optional - adapters are implemented; credentials configure them)
# ---------------------------------------------------------------------------
# Google OAuth (Gmail read-only, Calendar, Drive).
# Redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub personal access token (repo read) and/or OAuth app for connect flow.
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Local disk directory for uploaded documents (relative to repo root).
# V1 ships a local storage adapter; swap for S3-compatible object storage later.
FILE_STORAGE_DIR=".data/files"
