# ============================================================================
# Rauell OS - Environment Configuration
# Copy this file to `.env.local` and fill in the values. Never commit secrets.
# ============================================================================

# ---- Application -----------------------------------------------------------
# Public base URL (used in emails, links, OAuth redirects).
NEXT_PUBLIC_APP_URL="https://ai-os.rauell.systems"
# Canonical domain used for production links and OAuth callbacks.
APP_URL="https://ai-os.rauell.systems"

# ---- Database --------------------------------------------------------------
# Local development (default): leave DATABASE_URL unset to use the embedded
# file database at ./data/rauell.db (sql.js, no server required).
#
# Production (Neon PostgreSQL): set a connection string from your Neon console.
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# When DATABASE_URL begins with postgresql:// or postgres:// the app
# automatically switches to the Postgres backend (node-postgres) and runs the
# same dialect-neutral migrations.
#
# NOTE: the line below is commented out, so copying this file to .env.local
# leaves it INACTIVE and the app quietly stays on SQLite. To use Postgres,
# remove the leading '#' and paste your own connection string. Prefer the
# POOLED Neon endpoint (host contains "-pooler"): serverless functions open
# many short-lived connections and exhaust a direct endpoint.
# Verify with `npm run db:migrate`, which prints the backend it selected.
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ------------------------------------------------------------------
# Secret used to sign session JWTs. Generate a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Session lifetime in seconds (default 30 days).
SESSION_TTL="2592000"

# ---- AI Providers (all optional) ------------------------------------------
# The application is fully usable without any AI key (rule-based fallback).
# When a key is present, the provider abstraction routes model roles to it.
#
# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# NVIDIA NIM / hosted API Catalog
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
# Default provider: openai | anthropic | gemini | nvidia
AI_DEFAULT_PROVIDER="openai"

# ---- Integrations (optional, configured in-app) ----------------------------
# Google OAuth (Gmail / Calendar / Drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://ai-os.rauell.systems/api/integrations/google/callback"
# GitHub OAuth (read repositories)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- File storage (optional) ----------------------------------------------
# Object storage is used for document binaries in production. Locally, files
# are stored under ./data/documents.
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# ---- Automation / cron -----------------------------------------------------
# Shared secret for triggering server-side automation endpoints. Required:
# /api/automations/run authenticates with this instead of a session cookie and
# refuses to run when it is unset.
CRON_SECRET="change-me-cron-secret"

# ---- Seeding ---------------------------------------------------------------
# `npm run db:seed` refuses to run unless SEED_PASSWORD is set. There is
# deliberately no default: a committed password is a live credential on any
# reachable deployment.
#   SEED_PASSWORD="<a strong password>" npm run db:seed
# SEED_EMAIL and SEED_NAME optionally override the seeded identity.
# SEED_PASSWORD=""
# SEED_EMAIL=""
# SEED_NAME=""

# ---- Storage location (optional) -------------------------------------------
# Where the embedded SQLite file is written when DATABASE_URL is unset.
# Defaults to ./data, falling back to the system temp directory when the
# deployment filesystem is read-only (as on Vercel). Temp storage is ephemeral:
# set DATABASE_URL for anything you need to keep.
# RAUELL_DATA_DIR=""

# ---- Encryption ------------------------------------------------------------
# 32-byte key (base64) used to encrypt sensitive integration tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
