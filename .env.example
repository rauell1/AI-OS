# ============================================================================
# Rauell OS - Environment Configuration
# Copy this file to `.env.local` and fill in the values. Never commit secrets.
# ============================================================================

# ---- Application -----------------------------------------------------------
# Public base URL (used in emails, links, OAuth redirects).
NEXT_PUBLIC_APP_URL="https://ai-os.rauell.systems"
# Canonical domain used for production links and OAuth callbacks.
APP_URL="https://ai-os.rauell.systems"

# ---- Database --------------------------------------------------------------
# Local development (default): leave DATABASE_URL unset to use the embedded
# file database at ./data/rauell.db (sql.js, no server required).
#
# Production (Neon PostgreSQL): set a connection string from your Neon console.
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=verify-full
# Prefer sslmode=verify-full over sslmode=require: node-postgres treats them
# identically today but warns on every cold start that a future major version
# will weaken "require" to libpq semantics.
# When DATABASE_URL begins with postgresql:// or postgres:// the app
# automatically switches to the Postgres backend (node-postgres) and runs the
# same dialect-neutral migrations.
#
# NOTE: the line below is commented out, so copying this file to .env.local
# leaves it INACTIVE and the app quietly stays on SQLite. To use Postgres,
# remove the leading '#' and paste your own connection string. Prefer the
# POOLED Neon endpoint (host contains "-pooler"): serverless functions open
# many short-lived connections and exhaust a direct endpoint.
# Verify with `npm run db:migrate`, which prints the backend it selected.
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# ---- Auth ------------------------------------------------------------------
# The single identity allowed to sign in. REQUIRED: sign-in is refused for
# every address when this is unset, which locks you out of your own
# deployment. Set it before deploying.
#
# Deliberately not a NEXT_PUBLIC_ variable - those are inlined into the browser
# bundle, which would publish the address to anyone loading the site.
OWNER_EMAIL="you@example.com"

# Secret used to sign session JWTs. Generate a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Session lifetime in seconds (default 30 days).
SESSION_TTL="2592000"

# ---- AI Providers ----------------------------------------------------------
# Optional in the sense that the app runs without one: scoring, matching and
# dedupe are rule-based and work with no key at all. What does NOT work without
# one: the daily brief narrative, the chat assistant, CV tailoring, the
# researcher agent, and reading a CV in the profile importer - each degrades
# silently to nothing. Set at least one key to get the AI half of the system.
# The dashboard checklist shows which of these is configured.
#
# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# NVIDIA NIM / hosted API Catalog
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
# Default provider: openai | anthropic | gemini | nvidia
AI_DEFAULT_PROVIDER="openai"

# ---- Integrations (optional, configured in-app) ----------------------------
# Google OAuth (Gmail / Calendar / Drive)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://ai-os.rauell.systems/api/integrations/google/callback"
# GitHub OAuth (read repositories)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- File storage (optional) ----------------------------------------------
# Object storage is used for document binaries in production. Locally, files
# are stored under ./data/documents.
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# ---- Automation / cron -----------------------------------------------------
# Shared secret for triggering server-side automation endpoints. Required:
# /api/automations/run authenticates with this instead of a session cookie and
# refuses to run when it is unset.
CRON_SECRET="change-me-cron-secret"

# ---- Seeding ---------------------------------------------------------------
# The seed attaches its data to ONE account, and row level security makes that
# data invisible to every other account. It targets SEED_EMAIL, falling back to
# OWNER_EMAIL - so with OWNER_EMAIL set above, `npm run db:seed` populates the
# account you actually sign in as, and needs no further configuration.
#
#   npm run db:seed
#
# SEED_PASSWORD is only required when that account does not exist yet, because
# the seed then has to create it. There is deliberately no default: a committed
# password is a live credential on any reachable deployment.
#
#   SEED_PASSWORD="<a strong password>" npm run db:seed
#
# Re-running against an account that already has data is skipped; set
# SEED_FORCE=1 to clear that account's data and seed it again. Neither the seed
# nor `npm run db:reset` ever deletes the account itself.
# SEED_PASSWORD=""
# SEED_EMAIL=""
# SEED_NAME=""
# SEED_FORCE=""

# ---- Storage location (optional) -------------------------------------------
# Where the embedded SQLite file is written when DATABASE_URL is unset.
# Defaults to ./data, falling back to the system temp directory when the
# deployment filesystem is read-only (as on Vercel). Temp storage is ephemeral:
# set DATABASE_URL for anything you need to keep.
# RAUELL_DATA_DIR=""

# ---- Encryption ------------------------------------------------------------
# 32-byte key (base64) used to encrypt sensitive integration tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# REQUIRED to connect an integration in production. Outside production a key is
# derived from a constant so the app runs unconfigured, but that constant is in
# this public repository - so in production the fallback is refused rather than
# used, and connecting an integration fails until this is set.
TOKEN_ENCRYPTION_KEY=""
