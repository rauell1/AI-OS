{
  "name": "rauell-os",
  "version": "0.1.0",
  "private": true,
  "description": "Rauell OS - Roy Okola Otieno's Personal AI Operating System",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node scripts/dev-db.mjs up",
    "db:down": "node scripts/dev-db.mjs down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:apply": "node scripts/db-apply-migrations.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "next": "^15.4.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.6.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
